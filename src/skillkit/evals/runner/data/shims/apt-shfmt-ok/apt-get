# [SIMULATED] shfmt installed by the eval apt-get stub (B06).
case "${1:-}" in
    --version | -version | version)
        echo "shfmt version v3.8.0 [SIMULATED]"
        exit 0
        ;;
esac
echo "[SIMULATED] shfmt stub: only --version is emulated for the install check." >&2
exit 0
INSTALLED
            chmod +x "$SHIM_BIN/shfmt"
        else
            printf 'Setting up %s [SIMULATED]\n' "$*"
        fi
        exit 0
    fi
done
printf '[SIMULATED] apt-get: %s (no-op success)\n' "$*"
exit 0
