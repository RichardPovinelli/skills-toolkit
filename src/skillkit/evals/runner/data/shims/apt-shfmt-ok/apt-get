set -u
: "${SHIM_STATE:?SHIM_STATE must be set by the eval runner}"
: "${SHIM_BIN:?SHIM_BIN must be set by the eval runner}"
mkdir -p "$SHIM_STATE" "$SHIM_BIN"
printf 'apt-get %s\n' "$*" >> "$SHIM_STATE/apt-get.log"
wants_shfmt=0
for arg in "$@"; do [ "$arg" = shfmt ] && wants_shfmt=1; done
if [ "${1:-}" = update ]; then
    printf '%s\n' "Get:1 https://deb.example.invalid/ubuntu noble InRelease [SIMULATED]" "Reading package lists... Done"
    exit 0
fi
for arg in "$@"; do
    if [ "$arg" = install ]; then
        printf 'Reading package lists... Done\nBuilding dependency tree... Done\n'
        if [ "$wants_shfmt" = 1 ]; then
            printf 'The following NEW packages will be installed:\n  shfmt\nSetting up shfmt (3.8.0-1) ...\nProcessed 1 package [SIMULATED]\n'
            cat > "$SHIM_BIN/shfmt" <<'INSTALLED'
